# Rust toolchain version — kept in sync with the MSRV declared in
# contracts/payment-processing-contract/Cargo.toml (rust-version = "1.79.0")
# and the CI matrix in .github/workflows/ci.yml.  Override at build time with:
#   docker compose build --build-arg RUST_VER=1.80.0
ARG RUST_VER=1.79
FROM rust:${RUST_VER}-bookworm

# Install Stellar CLI and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Stellar CLI
RUN curl -sSL https://raw.githubusercontent.com/stellar/stellar-cli/main/install.sh | bash
ENV PATH="/root/.local/bin:${PATH}"

# Add WASM target
RUN rustup target add wasm32-unknown-unknown

# Install cargo tools
RUN cargo install cargo-audit --version 0.21.2 --locked

WORKDIR /workspace

CMD ["bash"]
