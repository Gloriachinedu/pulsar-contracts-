# Analytics database connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/pulsar_analytics

# Port the analytics service listens on (optional, default 3100)
PORT=3100

# Cache TTL for analytics query results, in seconds.
# Set to 0 (or leave unset) to disable caching and always return fresh data.
# Recommended: 60 for near-real-time dashboards, 300 for heavier reports.
ANALYTICS_CACHE_TTL_SECONDS=60
