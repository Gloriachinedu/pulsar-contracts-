# Pulsar Contract Monitor — environment variable configuration
# Copy this file to .env and fill in the values for your deployment.
# Never commit a .env file with real secrets to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Deployed Pulsar contract address to monitor.
CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# ── Stellar network ───────────────────────────────────────────────────────────

# Horizon base URL.
# Testnet:  https://horizon-testnet.stellar.org  (default)
# Mainnet:  https://horizon.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Polling ───────────────────────────────────────────────────────────────────

# How often (ms) to poll Horizon for new contract events.
# Default: 15000 (15 seconds)
POLL_INTERVAL_MS=15000

# ── Alert thresholds ──────────────────────────────────────────────────────────

# Refund rate alert threshold (0–1).
# Fire an alert when refunds / payments exceeds this fraction within the window.
# Default: 0.20 (20 %)
REFUND_RATE_THRESHOLD=0.20

# Rolling window (ms) for the refund rate and error rate metrics.
# Default: 3600000 (1 hour)
REFUND_RATE_WINDOW_MS=3600000

# Large-payment alert threshold (token units, e.g. stroops for XLM).
# Default: 1000000000 (1 000 XLM at 7 decimal places)
LARGE_PAYMENT_THRESHOLD=1000000000

# Error rate alert threshold (0–1).
# Fire an alert when failed polls / total polls exceeds this fraction.
# Default: 0.05 (5 %)
ERROR_RATE_THRESHOLD=0.05

# ── Alert delivery ────────────────────────────────────────────────────────────

# Webhook URL to POST alert payloads to (Slack, PagerDuty, or any HTTP endpoint).
# Leave empty to only log alerts to stdout.
# Examples:
#   Slack:      https://hooks.slack.com/services/T.../B.../xxx
#   PagerDuty:  https://events.pagerduty.com/v2/enqueue
ALERT_WEBHOOK_URL=
