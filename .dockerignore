# =============================================================================
# Docker build context exclusions
# =============================================================================
# Keeps `docker compose build` fast by preventing large/local-only artefacts
# from being sent to the Docker daemon as build context.  Anything mounted into
# the dev container at runtime is unaffected — `docker-compose.yml` bind-mounts
# the whole repo into /workspace, so these exclusions only apply to the image
# *build* step, not to the running container.
# =============================================================================

# Rust build artefacts — can be many GB; regenerated inside the container
target/
**/target/

# Git history and metadata
.git/
.gitignore
.gitattributes

# GitHub / CI metadata
.github/
.gitlab-ci.yml

# Node / API layer (not needed inside the Rust dev image)
api/node_modules/
api/dist/
api/.env

# Python / pre-commit caches
**/__pycache__/
*.pyc
.venv/
venv/

# Test snapshots and coverage artefacts (regenerated by cargo test)
**/test_snapshots/
**/lcov.info
**/coverage/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db

# Docs / Markdown not required to compile the Rust image
docs/
*.md
!README.md

# Large local config that should not be baked into the image
config/local.toml
